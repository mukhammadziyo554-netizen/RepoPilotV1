# Optional. A fine-grained token with read-only public repository metadata access raises GitHub API limits.
GITHUB_TOKEN=

# Step 3 active analysis provider: 'anthropic' or 'bob' (IBM Bob)
# - anthropic: Anthropic API (works everywhere: local, Vercel, self-hosted)
# - bob: IBM Bob (auto-selects CLI for local dev, HTTP API for Vercel)
ANALYSIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# IBM Bob Configuration
# For local development with Bob Shell 2.0.5:
#   1. Install: npm install -g bob-shell (or use existing installation)
#   2. Set BOB_API_KEY and ANALYSIS_PROVIDER=bob
#   3. CLI mode will activate automatically
#
# For Vercel / cloud deployment with IBM Bob HTTP API:
#   1. Log into bob.ibm.com → Your Subscription → API Key Management
#   2. Create an "Inference" type API key and copy it
#   3. Create an "Inference" type API key → find your instance-specific endpoint URL
#   4. Set BOB_API_KEY, BOB_INFERENCE_ENDPOINT, and ANALYSIS_PROVIDER=bob
#   5. HTTP API mode will activate automatically
BOB_API_KEY=
BOB_INFERENCE_ENDPOINT=
BOB_TEAM_ID=

# Local server settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
