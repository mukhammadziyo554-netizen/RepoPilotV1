# Optional. A fine-grained token with read-only public repository metadata access raises GitHub API limits.
GITHUB_TOKEN=

# Step 3 active analysis provider. IBM Bob can be added later by implementing
# the AnalysisProvider interface; no IBM credentials or client are needed yet.
ANALYSIS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Local server settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
